# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# In production, paste the same lines into the Komodo Stack's Environment —
# Komodo writes its own .env next to docker-compose.yml on the server.

# ── Contact relay ─────────────────────────────────────────────────────────────
# The contact form (app/api/contact/route.ts) POSTs the message here, server-side,
# from VM 103 to the n8n webhook on ubuntu-main over the private LAN. NOT a
# NEXT_PUBLIC_ var — this internal address must never reach the browser.
#
# Body sent: { "name": "...", "email": "...", "message": "..." } as JSON.
# (Subject, if filled, is folded into message so it shows up in the notification.)
CONTACT_WEBHOOK_URL=http://192.168.1.125:5678/webhook/contact-form

# Optional shared secret. If set, sent as the header `x-contact-token`. Check it
# in the n8n workflow's first node so only this server can trigger the webhook.
# Leave blank while building; add it once the site is public.
CONTACT_WEBHOOK_TOKEN=
